<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        android:padding="20dp"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="약속방" android:textSize="11sp" android:textStyle="bold"
            android:textColor="#9AA0C7" android:letterSpacing="0.03" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="함께 맞춰가요" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/white" android:layout_marginTop="6dp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <!-- 초대코드 입력 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="초대코드로 참여하기"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/navy"
                android:layout_marginBottom="12dp" />

            <!-- 코드 입력 6칸 -->
            <LinearLayout android:id="@+id/code_input_row"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:weightSum="6">
                <EditText android:id="@+id/code1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_code_box" android:gravity="center" android:inputType="textCapCharacters" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/navy" />
                <EditText android:id="@+id/code2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_code_box" android:gravity="center" android:inputType="textCapCharacters" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/navy" />
                <EditText android:id="@+id/code3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_code_box" android:gravity="center" android:inputType="textCapCharacters" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/navy" />
                <EditText android:id="@+id/code4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_code_box" android:gravity="center" android:inputType="textCapCharacters" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/navy" />
                <EditText android:id="@+id/code5" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_code_box" android:gravity="center" android:inputType="textCapCharacters" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/navy" />
                <EditText android:id="@+id/code6" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_code_box" android:gravity="center" android:inputType="textCapCharacters" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/navy" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_join_room"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="참여하기" android:textSize="15sp" android:textStyle="bold"
                android:backgroundTint="@color/amber" android:textColor="@color/navy"
                app:cornerRadius="14dp" android:layout_marginTop="14dp" />

            <!-- 구분선 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="24dp" android:layout_marginBottom="24dp">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/line_gray" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  또는  " android:textColor="@color/slate" android:textSize="13sp" android:textStyle="bold" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/line_gray" />
            </LinearLayout>

            <!-- 새 방 만들기 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="새 약속방 만들기"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/navy"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_room"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="새 약속방 만들기 →" android:textSize="15sp"
                android:textStyle="bold" android:textColor="@color/white"
                android:backgroundTint="@color/navy"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>