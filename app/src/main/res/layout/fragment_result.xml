<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 결과 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/navy"
            android:padding="20dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← 다시 설정" />

            <TextView
                android:id="@+id/tv_route_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="고려대 → 강남역 2번 출구"
                android:textSize="12sp"
                android:textColor="#9AA0C7"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">
                <TextView android:id="@+id/tv_depart_time"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="18:14" android:textSize="38sp" android:textStyle="bold" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  →  " android:textSize="20sp" android:textColor="#9AA0C7" />
                <TextView android:id="@+id/tv_arrive_time"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="19:00" android:textSize="38sp" android:textStyle="bold" android:textColor="#9AA0C7" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_transport_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="지하철 2호선 · 추천"
                android:textSize="13sp"
                android:textColor="@color/mint"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- 3개 스탯 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:weightSum="3">

            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_white" app:strokeWidth="1dp" app:strokeColor="@color/line_gray">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:id="@+id/tv_seat_prob" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="62%" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/navy" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="앉을 확률" android:textSize="10sp" android:textColor="@color/slate" android:textStyle="bold" android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_white" app:strokeWidth="1dp" app:strokeColor="@color/line_gray">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:id="@+id/tv_rain_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/navy" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="비 예보" android:textSize="10sp" android:textColor="@color/slate" android:textStyle="bold" android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/card_white" app:strokeWidth="1dp" app:strokeColor="@color/line_gray">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:id="@+id/tv_travel_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="46분" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/navy" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이동 시간" android:textSize="10sp" android:textColor="@color/slate" android:textStyle="bold" android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- 시간 분해 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_white"
            app:strokeWidth="1dp"
            app:strokeColor="@color/line_gray">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="왜 이 시간을 추천했나요?"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy"
                    android:layout_marginBottom="12dp" />

                <!-- 스택 바 (View들로 구성) -->
                <LinearLayout
                    android:id="@+id/stack_bar"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_rounded_bar"
                    android:layout_marginBottom="12dp" />

                <!-- 범례 -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/legend_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingVertical="4dp"
                    app:chipSpacingHorizontal="6dp" />

                <!-- 안내 메모 -->
                <LinearLayout
                    android:id="@+id/note_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_note"
                    android:padding="12dp"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:id="@+id/tv_recommendation_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12.5sp"
                        android:textColor="#8A5A00"
                        android:lineSpacingMultiplier="1.4" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 세부정보 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="지하철 칸 혼잡도 보기"
            android:textSize="14sp"
            android:textColor="@color/navy"
            app:strokeColor="@color/line_gray"
            app:cornerRadius="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnViewMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="지도에서 경로 보기" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>