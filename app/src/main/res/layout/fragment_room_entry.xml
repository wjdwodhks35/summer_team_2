<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6FA"
    android:gravity="center">

    <!-- 로고/타이틀 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="방 기능"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1B1F3B"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="친구들과 함께 출발 시간을 맞춰요"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="48dp" />

    <!-- 방 만들기 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create_room"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="방 만들기"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#1B1F3B"
        app:cornerRadius="16dp"
        android:layout_marginBottom="16dp" />

    <!-- 방 참여하기 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_join_room"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="초대 코드로 참여하기"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@android:color/transparent"
        app:strokeColor="#1B1F3B"
        app:strokeWidth="2dp"
        android:textColor="#1B1F3B"
        app:cornerRadius="16dp" />

</LinearLayout>