<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6FA"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="방 참여하기"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1B1F3B"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="친구에게 받은 초대 코드를 입력하세요"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="40dp" />

    <!-- 초대 코드 입력 -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="초대 코드 (예: 72K9-XQ)"
        app:hintTextColor="#888888"
        app:boxStrokeColor="#1B1F3B"
        app:boxBackgroundColor="#FFFFFF">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_invite_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:textColor="#1B1F3B"
            android:textColorHint="#AAAAAA" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="대소문자 구분 없이 입력해도 됩니다"
        android:textSize="12sp"
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_join"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="방 참여하기"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#1B1F3B"
        app:cornerRadius="14dp" />

</LinearLayout>