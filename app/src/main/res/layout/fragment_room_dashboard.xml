<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_gray">

    <!-- 목적지 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/navy"
        android:padding="20dp">
        <TextView android:id="@+id/tv_dest_eyebrow"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="최종 목적지" android:textSize="11sp" android:textStyle="bold" android:textColor="#B9C0F0" />
        <TextView android:id="@+id/tv_destination"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="강남역 2번 출구" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/white" android:layout_marginTop="6dp" android:layout_marginBottom="14dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="약속 시간" android:textSize="10sp" android:textColor="#C7CCF2" android:textStyle="bold" />
                <TextView android:id="@+id/tv_meeting_time"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="19:00" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/white" android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="참여 인원" android:textSize="10sp" android:textColor="#C7CCF2" android:textStyle="bold" />
                <TextView android:id="@+id/tv_member_count"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="4명" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/white" android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="상태" android:textSize="10sp" android:textColor="#C7CCF2" android:textStyle="bold" />
                <TextView android:id="@+id/tv_room_status"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="3명 준비중" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/white" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 초대코드 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/card_white"
        android:padding="14dp"
        android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="초대코드" android:textSize="11sp" android:textColor="@color/slate" android:textStyle="bold" />
            <TextView android:id="@+id/tv_invite_code"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="72K9-XQ" android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/navy" android:letterSpacing="0.05" android:layout_marginTop="2dp" />
        </LinearLayout>
        <TextView android:id="@+id/tv_copy_code"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="복사하기" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/teal"
            android:padding="8dp" />
    </LinearLayout>

    <!-- 참여자 목록 -->
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="참여자" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/slate"
        android:layout_marginStart="16dp" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_members"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_invite_more"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="+ 새 참여자 초대하기"
        android:textColor="@color/teal"
        app:strokeColor="@color/slate"
        app:cornerRadius="14dp"
        android:layout_margin="16dp" />

</LinearLayout>