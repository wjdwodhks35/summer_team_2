<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- 컬러 아바타 원 -->
        <TextView
            android:id="@+id/tv_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="14dp" />

        <!-- 이름 + 출발지 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 이름 행 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tv_member_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이름"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1B1F3B" />

                <!-- 방장 뱃지 -->
                <TextView
                    android:id="@+id/tv_host_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="방장"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/badge_host"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone" />

                <!-- (나) 표시 -->
                <TextView
                    android:id="@+id/tv_me_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="나"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/badge_me"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 출발지 or 위치 비공개 -->
            <TextView
                android:id="@+id/tv_departure_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="위치 비공개"
                android:textSize="12sp"
                android:textColor="#888888" />
        </LinearLayout>

        <!-- 오른쪽: 예상 소요 시간 -->
        <TextView
            android:id="@+id/tv_travel_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1B1F3B" />

    </LinearLayout>
</androidx.cardview.widget.CardView>